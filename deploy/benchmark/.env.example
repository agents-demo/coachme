# Required first-boot administrator (only used while users.json is empty)
COACHME_BENCHMARK_ADMIN_USER=admin
COACHME_BENCHMARK_ADMIN_PASSWORD=change-this-password
COACHME_BENCHMARK_ADMIN_TENANT=default

COACHME_BENCHMARK_AUTH=1
COACHME_BENCHMARK_COOKIE_SECURE=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
COACHME_BENCHMARK_SESSION_SECRET=replace-with-a-long-random-secret

# Optional:
# COACHME_BENCHMARK_TENANTS_ROOT=/data/tenants
# COACHME_BENCHMARK_AUTH_DIR=/data/.auth
# MODEL_PROVIDER=OpenAI
# API_BASE=https://...
# API_KEY=...
# MODEL_NAME=...
# VISION_MODEL_NAME=...
